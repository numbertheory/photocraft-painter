# PhotoCraft Painter Configuration

# PhotoCraft Control Protocol
PHOTOCRAFT_CONTROL_PORT=7878
PHOTOCRAFT_CONTROL_TOKEN_FILE=/home/jp/.config/photocraft/control.token

# Default AI Composer: Ollama
PAINTER_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=ornith-1.5:35b

# Optional: OpenAI / OpenRouter
# PAINTER_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
